{
  "name": "shiftland",
  "private": true,
  "version": "0.1.0",
  "description": "Shiftland: slide tectonic plates to make every creature on the island happy (GitHub Game Off 2026, theme SHIFT).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4327 --strictPort",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "levels": "node src/solver/cli.ts gen",
    "levels:audit": "node src/solver/cli.ts audit",
    "levels:export": "node src/solver/cli.ts export"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  }
}
